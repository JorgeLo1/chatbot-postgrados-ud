# Archivo de ejemplo de variables de entorno.
# Copiar a .env y completar con valores reales. NUNCA versionar .env.

# ── Puertos ──────────────────────────────────────────────────────────────────
PORT=5005
ACTION_SERVER_PORT=5055
WHATSAPP_ADAPTER_PORT=5006

# ── Oracle APEX ──────────────────────────────────────────────────────────────
APEX_API_URL=https://oracleapex.com/ords/udchatbot/chatbot
APEX_TIMEOUT=120
# true en producción SIEMPRE. false solo en desarrollo sin certificado válido.
APEX_SSL_VERIFY=true

# ── Cache ────────────────────────────────────────────────────────────────────
ENABLE_CACHE=True
CACHE_TTL=3600

# ── WhatsApp Business (Meta Graph v18) ───────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=tu_token_de_verificacion_aqui
# Secreto de la app Meta — necesario para verificación HMAC del webhook
WHATSAPP_APP_SECRET=tu_app_secret_aqui
WHATSAPP_ACCESS_TOKEN=tu_access_token_aqui
WHATSAPP_PHONE_NUMBER_ID=tu_phone_number_id_aqui
WHATSAPP_BUSINESS_ACCOUNT_ID=tu_business_account_id_aqui
WHATSAPP_API_VERSION=v18.0
RASA_URL=http://127.0.0.1:5005/webhooks/rest/webhook

# ── Sesiones / inactividad ───────────────────────────────────────────────────
INACTIVITY_TIMEOUT=300
INACTIVITY_WARNING_TIME=240

# ── Redis (opcional — fallback in-memory si no disponible) ───────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ── Fase A: búsqueda FAQ local ────────────────────────────────────────────────
# true = habilita índice local + rapidfuzz/BM25 antes de consultar Oracle
BUSQUEDA_LOCAL_HABILITADA=true
# Frecuencia de refresh del índice local en minutos (default 10)
FAQ_INDEX_REFRESH_MINUTES=10

# ── Fase A.7: umbrales de alerta de métricas FAQ ──────────────────────────────
# Hit rate mínimo aceptable (0.0–1.0)
FAQ_HIT_RATE_ALERT_THRESHOLD=0.70
# Tasa de fallback máxima aceptable (0.0–1.0)
FAQ_FALLBACK_RATE_THRESHOLD=0.20
# Tiempo máximo p95 en milisegundos
FAQ_P95_MS_THRESHOLD=3000

# ── Entorno ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
