# ============================================
# CONFIGURACIÓN DE ORACLE APEX API
# ============================================

# URL base de la API (sin el endpoint específico)
APEX_API_URL=https://oracleapex.com/ords/udchatbot/chatbot

# Timeout para las peticiones (en segundos)
APEX_TIMEOUT=60

# ============================================
# CONFIGURACIÓN DE CACHE
# ============================================

# Habilitar/deshabilitar cache
ENABLE_CACHE=True

# Tiempo de vida del cache (en segundos)
# 3600 = 1 hora
# 1800 = 30 minutos
# 900 = 15 minutos
CACHE_TTL=3600

# ============================================
# LOGGING
# ============================================

# Nivel de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# RASA CONFIGURATION
# ============================================

# Puerto del servidor de acciones
ACTION_SERVER_PORT=5055

# Puerto del servidor Rasa (para Render)
PORT=5005

# Indicador de entorno (development, production)
ENVIRONMENT=development

# ============================================
# ORACLE APEX ENDPOINTS DISPONIBLES
# ============================================
# /postgrados - GET: Lista todos los postgrados
# /postgrados/:id - GET: Detalle de un postgrado específico
# /buscar?nombre=X - GET: Buscar postgrados por nombre
# /faq/buscar/:id?pregunta=X - GET: Buscar respuesta FAQ
# /historial - POST: Guardar historial de conversación
# /contacto - POST: Registrar solicitud de contacto
# ============================================

# ============================================
# INSTRUCCIONES DE USO
# ============================================
# 1. Copiar este archivo: cp .env.example .env
# 2. Ajustar valores según tu entorno
# 3. NO subir .env a GitHub (ya está en .gitignore)
# ============================================
```

---

## 📋 **VARIABLES DE ENTORNO PARA RENDER**

Cuando despliegues en Render, configura estas variables en el dashboard:

### **Configuración en Render Dashboard**
```
Key                  | Value
---------------------|----------------------------------------
APEX_API_URL         | https://oracleapex.com/ords/udchatbot/chatbot
APEX_TIMEOUT         | 60
ENABLE_CACHE         | True
CACHE_TTL            | 3600
LOG_LEVEL            | INFO
ACTION_SERVER_PORT   | 5055
PORT                 | 5005
ENVIRONMENT          | production