# Servicio systemd para el túnel ngrok del chatbot WhatsApp
# ──────────────────────────────────────────────────────────
# Instalación (una sola vez en el servidor):
#
#   sudo cp chatbot-ngrok.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable chatbot-ngrok     # arranca con el servidor
#   sudo systemctl start chatbot-ngrok      # arrancar ahora
#
# Diagnóstico:
#   sudo systemctl status chatbot-ngrok
#   journalctl -u chatbot-ngrok -f
#
# Prerequisito: ~/.config/ngrok/ngrok.yml configurado (ver ngrok-config.yml.example)

[Unit]
Description=ngrok tunnel for WhatsApp Chatbot (port 5006)
After=network-online.target docker.service
Wants=network-online.target
# Docker debe estar corriendo para que el puerto 5006 exista
Requires=docker.service

[Service]
Type=simple
User=ubuntu
ExecStart=/usr/local/bin/ngrok start chatbot
Restart=always
RestartSec=10
# Esperar 30 s antes del primer intento para dar tiempo a que Docker levante el contenedor
ExecStartPre=/bin/sleep 30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=chatbot-ngrok

[Install]
WantedBy=multi-user.target
